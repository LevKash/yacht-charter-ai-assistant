# ─────────────────────────── Database (required) ───────────────────────────
# Postgres connection string. Works with local Postgres, Neon, Supabase, etc.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ─────────────────────────── Owner account ─────────────────────────────────
# Created automatically on first login page load if no owner exists.
# If omitted, the default is owner@baxyachting.com / changeme123 (change it in Settings!).
ADMIN_EMAIL=lev@baxyachting.com
ADMIN_PASSWORD=choose-a-strong-password

# ─────────────────────────── AI (OpenRouter) ───────────────────────────────
# Get a key at https://openrouter.ai/keys. Without it the app still works:
# answers show the best-matching cards verbatim and imports are split by paragraph.
OPENROUTER_API_KEY=
# Any OpenRouter model id. Cheap & capable defaults: deepseek/deepseek-chat,
# openai/gpt-4o-mini, google/gemini-flash-1.5. Can also be overridden in Settings → Advanced.
LLM_MODEL=deepseek/deepseek-chat

# ─────────────────────────── Voice notes (speech-to-text) ──────────────────
# Any OpenAI-compatible /audio/transcriptions endpoint. Leave STT_API_KEY empty
# to hide the voice import option.
#   OpenAI:  STT_BASE_URL=https://api.openai.com/v1      STT_MODEL=whisper-1
#   Groq:    STT_BASE_URL=https://api.groq.com/openai/v1  STT_MODEL=whisper-large-v3
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# ─────────────────────────── WhatsApp (Meta Cloud API) ─────────────────────
# All four are needed for the WhatsApp assistant. See README → "Connect WhatsApp".
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string you choose; paste the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# The name people use to mention the bot in a group, e.g. "@assistant how do I…"
WHATSAPP_BOT_DISPLAY_NAME=assistant

# ─────────────────────────── Misc ──────────────────────────────────────────
# Public URL of the deployment (used as referer for OpenRouter). Optional.
NEXT_PUBLIC_APP_URL=
